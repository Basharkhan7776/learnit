{
  "name": "@learnit/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.tsx",
      "import": "./src/*.tsx",
      "default": "./src/*.tsx"
    },
    "./Badge": "./src/Badge.tsx",
    "./Button": "./src/Button.tsx",
    "./DropdownMenu": "./src/DropdownMenu.tsx",
    "./GoLogo": "./src/GoLogo.tsx",
    "./Modal": "./src/Modal.tsx",
    "./ResizeHandle": "./src/ResizeHandle.tsx",
    "./Tooltip": "./src/Tooltip.tsx",
    "./utils": "./src/utils.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "lucide-react": "^1.43.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2"
  }
}
